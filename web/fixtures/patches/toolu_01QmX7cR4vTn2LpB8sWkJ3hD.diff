+import type { Request, Response, NextFunction } from 'express';
+import { MemoryStore } from './stores/memoryStore';
+
+/** Where hit times live. `hit` records one and returns the window's count. */
+export interface RateLimitStore {
+  hit(key: string, now: number, windowMs: number): Promise<{ count: number; oldest: number }>;
+  reset(key: string): Promise<void>;
+}
+
+export type RateLimitOptions = {
+  /** Requests allowed per window, per key. */
+  limit: number;
+  /** The sliding window, in milliseconds. */
+  windowMs: number;
+  /** Where the hit counts live; in memory unless given. */
+  store?: RateLimitStore;
+  /** The key a request counts against: the user id, else the client IP. */
+  keyOf?: (req: Request) => string;
+};
+
+const defaultKey = (req: Request) => req.user?.id ?? req.ip ?? 'anonymous';
+
+/**
+ * A sliding-window limiter: each key may make `limit` requests in any
+ * `windowMs`. Over the limit it answers 429 with Retry-After.
+ */
+export function rateLimit(options: RateLimitOptions) {
+  const store = options.store ?? new MemoryStore();
+  const keyOf = options.keyOf ?? defaultKey;
+
+  return async (req: Request, res: Response, next: NextFunction) => {
+    const key = keyOf(req);
+    const now = Date.now();
+    try {
+      const { count, oldest } = await store.hit(key, now, options.windowMs);
+      res.setHeader('RateLimit-Limit', String(options.limit));
+      res.setHeader('RateLimit-Remaining', String(Math.max(0, options.limit - count)));
+      if (count > options.limit) {
+        const retryMs = oldest + options.windowMs - now;
+        res.setHeader('Retry-After', String(Math.ceil(retryMs / 1000)));
+        return res.status(429).json({ error: 'rate_limited', retryAfterMs: retryMs });
+      }
+      next();
+    } catch (err) {
+      // a store outage must not take the API down: let the request through
+      req.log?.warn({ err }, 'rate limit store failed; allowing request');
+      next();
+    }
+  };
+}
