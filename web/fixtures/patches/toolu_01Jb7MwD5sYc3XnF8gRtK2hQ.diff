+import { describe, it, expect } from 'vitest';
+import request from 'supertest';
+import express from 'express';
+import { rateLimit } from '../src/middleware/rateLimit';
+import { MemoryStore } from '../src/middleware/stores/memoryStore';
+
+const appWith = (limit: number) => {
+  const app = express();
+  app.use(rateLimit({ limit, windowMs: 60_000, store: new MemoryStore(), keyOf: () => 'user-1' }));
+  app.get('/ping', (_req, res) => res.json({ ok: true }));
+  return app;
+};
+
+describe('rateLimit', () => {
+  it('lets requests through under the limit', async () => {
+    const app = appWith(3);
+    for (let i = 0; i < 3; i++) await request(app).get('/ping').expect(200);
+  });
+
+  it('answers 429 with Retry-After over the limit', async () => {
+    const app = appWith(2);
+    await request(app).get('/ping').expect(200);
+    await request(app).get('/ping').expect(200);
+    const res = await request(app).get('/ping').expect(429);
+    expect(Number(res.headers['retry-after'])).toBeGreaterThan(0);
+    expect(res.body.error).toBe('rate_limited');
+  });
+
+  it('reports the remaining budget', async () => {
+    const res = await request(appWith(5)).get('/ping').expect(200);
+    expect(res.headers['ratelimit-limit']).toBe('5');
+    expect(res.headers['ratelimit-remaining']).toBe('4');
+  });
+
+  it('lets a request through when the store fails', async () => {
+    const broken = { hit: () => Promise.reject(new Error('down')), reset: async () => {} };
+    const app = express();
+    app.use(rateLimit({ limit: 1, windowMs: 1000, store: broken }));
+    app.get('/ping', (_req, res) => res.json({ ok: true }));
+    await request(app).get('/ping').expect(200);
+  });
+});
